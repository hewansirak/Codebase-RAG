# Free key from https://console.groq.com — only needed for generated answers.
# Without it the app still works in retrieval-only mode.
GROQ_API_KEY=

# Any OpenAI-compatible endpoint and model can be used instead of Groq.
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# Embedding model (sentence-transformers) or "hashing" for the dependency-free baseline.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where clones and indexes are stored.
DATA_DIR=data

# Only for `python -m codebase_rag webhook`.
GITHUB_WEBHOOK_SECRET=
